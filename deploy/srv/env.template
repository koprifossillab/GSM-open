# /srv/GSM/.env 로 두는 것. 이 파일은 저장소에 두는 본이고, 실제 값은 장비에만 둔다.

# 오픈API 인증키.
GSM_KIGAM_KEY=

# 운영 비밀키. 반드시 바꾼다.
GSM_SECRET_KEY=

# 들어오는 호스트. nginx 뒤에 있으므로 **이 장비가 불리는 이름을 모두** 적는다.
# 빠진 이름으로 들어오면 Django 가 400 Bad Request 를 낸다.
# 여기를 못 고치면 <DB 가 있는 곳>/allowed_hosts 에 한 줄씩 적어도 된다.
GSM_ALLOWED_HOSTS=127.0.0.1,localhost,paleolab,paleo-server,172.16.116.98

# nginx 서브패스로 들어오면 원본 주소를 적어 둔다 (CSRF 검사에 쓰인다).
GSM_CSRF_TRUSTED_ORIGINS=

# 받아 두고 우리가 그리는 파일 둘은 .env 가 아니라 DB 옆 자리로 들어온다 —
# 배포한 자리의 compose 를 못 고쳐도 db/ 는 이미 붙어 있기 때문이다.
#   db/geomap/ATA_SCAR_GeoMAP_Geology_v2022_08.gpkg        남극 지질도 (devlog 018)
#   db/npolar/NP_J250_Geologi/NP_J250_Geologi_{f,l,p}.geojson  얀마옌 지질도 (devlog 022)
#   db/peninsula/geomap.pdf + tiles/  한반도 지질도 음영판 — build_peninsula 로 자른다 (devlog 027)
# 다른 곳에 두려면 GSM_GEOMAP_DIR·GSM_NPOLAR_DIR·GSM_PENINSULA_DIR 을 준다.

# 타일 캐시. 상류 부하를 줄인다.
GSM_TILE_CACHE_SECONDS=86400

# 인증키를 기다리는 동안의 임시 조치. 켜면 문서에 없는 주소로 곧장 간다.
# 켜져 있으면 화면 맨 위에 띠가 뜬다. CLAUDE.md "두 개의 상류 주소".
# 여기를 못 고치면 <DB 가 있는 곳>/dev_direct_wms 에 1 을 적어도 된다.
GSM_DEV_DIRECT_WMS=0
