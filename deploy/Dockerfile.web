# GSM(대돌여지도) 뷰어 이미지.
#
# 이미지가 하나뿐이다 — 이 저장소에는 파이프라인이 없다. 지도는 브라우저가
# 그리고 서버는 상류 타일을 중계할 뿐이라, 무거운 것이 들어올 자리가 없다.
#
# 자료(GSM.db, 올린 점묶음)는 굽지 않는다. /srv 에서 마운트해 본다.

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# 사내 CA 를 먼저 넣는다. 이것이 없으면 pip 도, 돌기 시작한 뒤의 상류 요청도
# CERTIFICATE_VERIFY_FAILED 로 멈춘다 — 까닭은 deploy/ca/README.md.
# `.crt` 가 없어도 넘어가게 두었다 (망 밖에서 굽는 경우).
COPY deploy/ca/ /usr/local/share/ca-certificates/gsm/
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && update-ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# 의존성을 코드보다 먼저 깐다 — 코드만 고쳤을 때 이 층을 다시 받지 않는다
COPY requirements-web.txt ./
RUN pip install -r requirements-web.txt

COPY . .

# 정적 파일을 여기서 모은다. **ForGIA 와 다른 점이다** — 저쪽 뷰어는
# 템플릿이 CSS·JS 를 인라인으로 들고 있어 collectstatic 이 필요 없지만,
# 여기는 OpenLayers 를 저장소에 담아 쓰므로 모아야 한다.
RUN cd web && GSM_SECRET_KEY=build-only python manage.py collectstatic --noinput

# 숫자 uid 로 돈다 (compose 의 user:). GSM.db 소유자가 바뀌지 않게 하려는 것이다.
ENV HOME=/tmp \
    XDG_CACHE_HOME=/tmp/.cache

EXPOSE 9090

ENTRYPOINT ["/app/deploy/entrypoint-web.sh"]
