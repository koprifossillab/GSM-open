# GSM 환경변수. `.env` 로 복사해 채운다. `.env` 는 커밋하지 않는다.

# 오픈API 인증키. https://data.kigam.re.kr/my-openapi/request/ 에서 받는다.
# 비워두면 뷰어는 돌되 타일 자리에 안내가 뜬다.
GSM_KIGAM_KEY=

# 상류 WMS. 문서화된 주소다. 바꿀 일이 거의 없다.
GSM_WMS_URL=https://data.kigam.re.kr/openapi/wms

# 씨앗 뽑기 전용. 문서에 없는 주소이고 제품이 돌 때는 타지 않는다.
# `manage.py seed_catalog --from-upstream` 이 부를 때만 쓴다.
GSM_CAPABILITIES_URL=https://data.kigam.re.kr/mgeo/geoserver/wms

# Django
GSM_SECRET_KEY=개발용-아무-값-운영에서는-반드시-바꾼다
GSM_DEBUG=1
GSM_ALLOWED_HOSTS=127.0.0.1,localhost
GSM_URL_PREFIX=GSM/

# 타일 캐시. 상류 부하를 줄이려고 둔다. 0 이면 끈다.
GSM_TILE_CACHE_SECONDS=86400

# ── 개발 스위치 ───────────────────────────────────────────────────────
# 켜면 상류 요청이 문서화된 /openapi/wms 가 아니라 GeoServer 로 곧장 간다.
# 인증키가 없어도 타일·속성·범례가 다 나와서, 키를 기다리는 동안 뷰어를
# 끝까지 굴려볼 수 있다. **운영에서는 반드시 0 으로 둔다.**
GSM_DEV_DIRECT_WMS=0

# 상류를 검증할 CA 꾸러미. 비우면 시스템 꾸러미를 찾아 쓴다.
# KOPRI 망은 TLS 를 가로채고(체인 끝이 CN=KOPRI SSL) 그 루트가 certifi 에는
# 없어서, 비워 두면 requests 가 CERTIFICATE_VERIFY_FAILED 로 멈춘다.
GSM_CA_BUNDLE=

# ── 타일 캐시 ─────────────────────────────────────────────────────────
# 받아온 타일을 우리 디스크에 두는 자리. 비우면 캐시를 끈다.
# 운영에서는 /srv/GSM/tiles 로 마운트한다.
GSM_TILE_CACHE_DIR=
# 이보다 늙은 타일은 다시 받는다.
GSM_TILE_CACHE_MAX_AGE_DAYS=30
# 이보다 커지면 `manage.py prune_tiles` 가 오래 안 쓰인 것부터 버린다 (2 GB).
GSM_TILE_CACHE_MAX_BYTES=2147483648

# 밖에 열 때 켠다. 연구실 안에서만 볼 레이어(중국 geo3al·한반도 지질도·암맥)를
# 목록에서 내리고 그 길도 닫는다. `<DB 옆>/public` 파일에 1 을 적어도 된다.
GSM_PUBLIC=0
