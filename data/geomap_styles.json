{
 "_주석": "GeoMAP v2022-08 과 함께 온 QGIS 스타일(.qml)에서 manage.py geomap_styles 로 뽑았다. 손으로 고치지 않는다 — 다시 뽑으면 덮인다. quality 만은 GNS 스타일이 없어 그 명령 안에서 정했다.",
 "_뽑은날": "2026-09-30",
 "styles": {
  "simple_geology": {
   "table": "units",
   "kind": "fill",
   "fields": ["SIMPCODE"],
   "source": "ATA geological units - Simple geology.qml",
   "rules": [
    {"label": "unconsolidated colluvium, talus, alluvium and undifferentiated till", "group": "Quaternary-Neogene", "when": [{"SIMPCODE": 20}], "fill": [255, 235, 175, 255], "outline": [255, 235, 175, 255], "width": 1.0, "pattern": "solid"},
    {"label": "youngest glacial gravel, till and supraglacial material  (Holocene)", "group": "Quaternary-Neogene", "when": [{"SIMPCODE": 21}], "fill": [255, 255, 190, 255], "outline": [255, 255, 190, 255], "width": 1.0, "pattern": "solid"},
    {"label": "unconsolidated coastal ice-shelf till, beach or lake deposits", "group": "Quaternary-Neogene", "when": [{"SIMPCODE": 22}], "fill": [211, 255, 190, 255], "outline": [211, 255, 190, 255], "width": 0.4, "pattern": "solid"},
    {"label": "older glacial gravel and till (Miocene-Quaternary)", "group": "Quaternary-Neogene", "when": [{"SIMPCODE": 23}], "fill": [255, 255, 0, 255], "outline": [255, 255, 0, 255], "width": 0.4, "pattern": "solid"},
    {"label": "sedimentary rock with interbedded volcanic or volcaniclastic rock", "group": "Cenozoic", "when": [{"SIMPCODE": 30}], "fill": [255, 170, 0, 255], "outline": [255, 170, 0, 255], "width": 1.0, "pattern": "solid"},
    {"label": "volcanic rock - basalt to rhyolite lava flows and pyroclastic material", "group": "Cenozoic", "when": [{"SIMPCODE": 31}], "fill": [255, 0, 0, 255], "outline": [255, 0, 0, 255], "width": 1.0, "pattern": "solid"},
    {"label": "intrusive rock - granite, granodiorite, gabbro, or syenite (Eocene-Oligocene)", "group": "Cenozoic", "when": [{"SIMPCODE": 32}], "fill": [230, 76, 0, 255], "outline": [230, 76, 0, 255], "width": 1.0, "pattern": "solid"},
    {"label": "sedimentary  and volcanic rocks, pyroclastic material (Jurassic to Paleogene)", "group": "Mesozoic-Cenozoic", "when": [{"SIMPCODE": 40}], "fill": [205, 205, 102, 255], "outline": [205, 205, 102, 255], "width": 1.0, "pattern": "solid"},
    {"label": "volcanic rock (Jurassic-Paleogene)", "group": "Mesozoic-Cenozoic", "when": [{"SIMPCODE": 41}], "fill": [137, 137, 68, 255], "outline": [137, 137, 68, 255], "width": 1.0, "pattern": "solid"},
    {"label": "Ferrar Igneous Province and related volcanic and sedimentary rock (Jurassic)", "group": "Mesozoic-Cenozoic", "when": [{"SIMPCODE": 42}], "fill": [168, 112, 0, 255], "outline": [168, 112, 0, 255], "width": 1.0, "pattern": "solid"},
    {"label": "silicic volcanic and continental sedimentary rock (Jurassic)", "group": "Mesozoic-Cenozoic", "when": [{"SIMPCODE": 43}], "fill": [215, 158, 158, 255], "outline": [215, 158, 158, 255], "width": 1.0, "pattern": "solid"},
    {"label": "unmetamorphosed granitoid, gabbro and other intrusive rock", "group": "Mesozoic-Cenozoic", "when": [{"SIMPCODE": 44}], "fill": [230, 0, 169, 255], "outline": [230, 0, 169, 255], "width": 1.0, "pattern": "solid"},
    {"label": "metamorphosed gneiss and migmatite (Triassic, Cretaceous)", "group": "Mesozoic-Cenozoic", "when": [{"SIMPCODE": 45}], "fill": [68, 101, 137, 255], "outline": [68, 101, 137, 255], "width": 1.0, "pattern": "solid"},
    {"label": "Beacon Supergroup and other sandstone-rich sedimentary rock (Devonian-Triassic)", "group": "Paleozoic-Mesozoic", "when": [{"SIMPCODE": 50}], "fill": [152, 230, 0, 255], "outline": [152, 230, 0, 255], "width": 0.4, "pattern": "solid"},
    {"label": "intrusive rock - granitoid, diorite, gabbro and orthogneiss", "group": "Proterozoic-Paleozoic", "when": [{"SIMPCODE": 60}], "fill": [255, 115, 223, 255], "outline": [255, 115, 223, 255], "width": 0.4, "pattern": "solid"},
    {"label": "folded low-grade metasedimentary and metavolcanic rock", "group": "Proterozoic-Paleozoic", "when": [{"SIMPCODE": 61}], "fill": [122, 182, 245, 255], "outline": [122, 182, 245, 255], "width": 0.4, "pattern": "solid"},
    {"label": "low to medium-grade metamorphic rock - schist, marble, metavolcanic, metasandstone", "group": "Proterozoic-Paleozoic", "when": [{"SIMPCODE": 62}], "fill": [102, 119, 205, 255], "outline": [102, 119, 205, 255], "width": 0.4, "pattern": "solid"},
