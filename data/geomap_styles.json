    {"label": "metamorphic and intrusive rock - schist, gneiss, granulite, migmatite and anatectite", "group": "Archean", "when": [{"SIMPCODE": 70}], "fill": [137, 68, 101, 255], "outline": [137, 68, 101, 255], "width": 0.4, "pattern": "solid"},
    {"label": "Seasonal water and ice", "group": "other features", "when": [{"SIMPCODE": 10}], "fill": [190, 232, 255, 255], "outline": [190, 232, 255, 255], "width": 1.0, "pattern": "solid"},
    {"label": "Unknown or unclassified rock", "group": "other features", "when": [{"SIMPCODE": 11}], "fill": [104, 104, 104, 255], "outline": [104, 104, 104, 255], "width": 1.0, "pattern": "solid"}
   ]
